# Copie este arquivo para ".env" e preencha a chave.
# O arquivo .env NÃO deve ser versionado nem compartilhado.

# Obrigatória (a menos que MOCK_MODE=true). Crie a sua de graça em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=cole-sua-chave-aqui

# Opcionais
# GEMINI_MODEL=gemini-flash-latest   # alias que sempre aponta para o Flash mais atual
# USE_WEB_SEARCH=true                # a IA pesquisa no Google para conferir as afirmações
# MOCK_MODE=false                    # true = respostas simuladas, sem chamar a API (só para testar a interface)
# PORT=3000
# ALLOWED_EXTENSION_ID=              # ID da extensão no Chrome; se preenchido, só ela pode usar o backend
